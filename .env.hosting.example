# TCW HR universal production environment
NODE_ENV=production
COOKIE_SECURE=true

# URLs: HR and Super Admin must be different HTTPS origins.
WEB_URL=https://hr.techcyberwarrior.in
ADMIN_URL=https://admin.techcyberwarrior.in
APP_ORIGINS=https://hr.techcyberwarrior.in,https://admin.techcyberwarrior.in
HR_DOMAIN=hr.techcyberwarrior.in
ADMIN_DOMAIN=admin.techcyberwarrior.in

# Ports used when opening the apps directly without a reverse proxy.
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
API_BIND_HOST=0.0.0.0

# Built-in Docker PostgreSQL / Redis settings.
POSTGRES_DB=tcw_hr
POSTGRES_USER=tcw_app
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://tcw_app:CHANGE_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/tcw_hr?schema=public
REDIS_URL=redis://redis:6379

# Internal URL used by Next.js server-side API proxy.
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_REALTIME_ENABLED=true

# SaaS / trial
PUBLIC_SIGNUP_ENABLED=true
TRIAL_DAYS=3
AUTO_SUSPEND_OVERDUE=true
OVERDUE_GRACE_DAYS=3
SEED_DEMO=false

# Platform administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_TO_A_RANDOM_20_PLUS_CHARACTER_PASSWORD
CONFIG_ENCRYPTION_KEY=CHANGE_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=TCW HR Software <noreply@example.com>

# S3-compatible file storage (AWS S3, Cloudflare R2, Backblaze B2 S3, MinIO, etc.)
S3_ENDPOINT=https://s3.example.com
S3_REGION=ap-south-1
S3_BUCKET=tcw-hr-production
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Optional integrations
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_INSTRUCTIONS=Contact billing to activate your subscription.
BIOMETRIC_PUBLIC_URL=https://hr.techcyberwarrior.in
BIOMAX_AUTO_MAP_EMPLOYEE_CODE=true
BIOMAX_ENFORCE_SOURCE_IP=false
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_WINDOWS_INSTALLER_URL=


# SMS onboarding (choose one provider)
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_LOGIN_READY_ID=
MSG91_TEMPLATE_USER_LOGIN_ID=
MSG91_TEMPLATE_TRIAL_LOGIN_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Live salary payouts (RazorpayX)
PAYROLL_PAYOUTS_ENABLED=false
PAYOUT_PROVIDER=RAZORPAYX
PAYOUT_COMPANY_CODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
