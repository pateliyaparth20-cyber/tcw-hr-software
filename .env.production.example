# TCW HR Software production example. Store real values in a secret manager.
NODE_ENV=production
DATABASE_URL=postgresql://tcw_app:CHANGE_ME@postgres:5432/tcw_hr?schema=public
POSTGRES_USER=tcw_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tcw_hr
REDIS_URL=redis://redis:6379
API_PORT=4000
API_BIND_HOST=0.0.0.0
API_INTERNAL_URL=http://api:4000
WEB_URL=https://hr.techcyberwarrior.in
ADMIN_URL=https://admin.techcyberwarrior.in
APP_ORIGINS=https://hr.techcyberwarrior.in,https://admin.techcyberwarrior.in
COOKIE_SECURE=true
PUBLIC_SIGNUP_ENABLED=true
TRIAL_DAYS=3
AUTO_SUSPEND_OVERDUE=true
OVERDUE_GRACE_DAYS=3
SEED_DEMO=false
ADMIN_EMAIL=admin@YOUR-DOMAIN.com
ADMIN_PASSWORD=GENERATE_A_RANDOM_PASSWORD_OF_20_PLUS_CHARS
CONFIG_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET
SMTP_HOST=smtp.YOUR-PROVIDER.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=TCW HR Software <noreply@YOUR-DOMAIN.com>
S3_ENDPOINT=https://YOUR-S3-ENDPOINT
S3_REGION=ap-south-1
S3_BUCKET=tcw-hr-production
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_INSTRUCTIONS=Contact billing to activate your subscription.
BIOMETRIC_PUBLIC_URL=https://hr.techcyberwarrior.in
BIOMAX_AUTO_MAP_EMPLOYEE_CODE=true
BIOMAX_ENFORCE_SOURCE_IP=false
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_WINDOWS_INSTALLER_URL=


# SMS onboarding (choose one provider)
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_LOGIN_READY_ID=
MSG91_TEMPLATE_USER_LOGIN_ID=
MSG91_TEMPLATE_TRIAL_LOGIN_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Live salary payouts (RazorpayX)
PAYROLL_PAYOUTS_ENABLED=false
PAYOUT_PROVIDER=RAZORPAYX
PAYOUT_COMPANY_CODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
