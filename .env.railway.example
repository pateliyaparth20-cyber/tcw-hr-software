# TCW HR Software v1.3.0 · Railway production example
# Recommended public domains (keeps your existing techcyberwarrior.in website untouched):
NODE_ENV=production
COOKIE_SECURE=true
WEB_URL=https://hr.techcyberwarrior.in
ADMIN_URL=https://admin.techcyberwarrior.in
APP_ORIGINS=https://hr.techcyberwarrior.in,https://admin.techcyberwarrior.in
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_REALTIME_ENABLED=false
PUBLIC_SIGNUP_ENABLED=true
TRIAL_DAYS=3
SEED_DEMO=false
AUTO_SUSPEND_OVERDUE=true
OVERDUE_GRACE_DAYS=3

# Railway managed services. Prefer Railway variable references in the Dashboard.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Platform administrator
ADMIN_EMAIL=CHANGE_TO_YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_TO_A_RANDOM_20_PLUS_CHARACTER_PASSWORD
CONFIG_ENCRYPTION_KEY=CHANGE_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Email (SMTP)
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=TCW HR Software <CHANGE_ME>

# File storage: S3-compatible provider is required for persistent production documents.
S3_ENDPOINT=CHANGE_ME
S3_REGION=ap-south-1
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# SMS. MSG91 is supported for Indian mobile delivery; TWILIO and generic WEBHOOK are also supported.
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME
# Optional per-template IDs override the default above:
MSG91_TEMPLATE_LOGIN_READY_ID=
MSG91_TEMPLATE_USER_LOGIN_ID=
MSG91_TEMPLATE_TRIAL_LOGIN_ID=
# Twilio alternative:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic webhook alternative:
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# AI assistant: OpenAI-compatible API. Keep blank until you have a provider key.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Salary payout. Keep false until RazorpayX account/KYC/API/IP rules are ready.
PAYROLL_PAYOUTS_ENABLED=false
PAYOUT_PROVIDER=RAZORPAYX
PAYOUT_COMPANY_CODE=CHANGE_TO_THE_COMPANY_CODE_ALLOWED_TO_PAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Attendance / BioMax public push receiver.
BIOMETRIC_PUBLIC_URL=https://hr.techcyberwarrior.in
BIOMAX_AUTO_MAP_EMPLOYEE_CODE=true
BIOMAX_ENFORCE_SOURCE_IP=false

# Optional app downloads
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_WINDOWS_INSTALLER_URL=
