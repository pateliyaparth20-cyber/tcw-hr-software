{$HR_DOMAIN} {
  encode zstd gzip

  # API, realtime, and native BioMax/ZKTeco PUSH/ADMS traffic go directly to the API.
  @backend path /api /api/* /iclock /iclock/* /socket.io/*
  handle @backend {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:3000
  }
}

{$ADMIN_DOMAIN} {
  encode zstd gzip
  @adminApi path /api /api/* /socket.io/*
  handle @adminApi {
    reverse_proxy api:4000
  }
  handle {
    reverse_proxy super-admin:3001
  }
}
