{
  "name": "tech-cyber-warrior-peopleos",
  "version": "1.4.1",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/super-admin"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,hr,admin,worker \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\" \"npm:dev:worker\"",
    "dev:api": "node --import tsx --watch apps/api/src/main.ts",
    "dev:web": "npm run dev --workspace=@peopleos/web",
    "dev:admin": "npm run dev --workspace=@peopleos/super-admin",
    "dev:worker": "node --import tsx apps/worker/src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web && tsc --noEmit -p apps/super-admin",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run build:backend && npm run build:frontends",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "postinstall": "prisma generate",
    "dev:embedded": "node --import tsx scripts/demo-server.ts",
    "demo": "npm run phone:stable",
    "test:ssr": "node --import tsx tests/e2e/ssr-smoke.ts",
    "configure:lan": "powershell -ExecutionPolicy Bypass -File ./scripts/configure-mobile-lan.ps1",
    "login:reset": "node --import tsx scripts/reset-login.ts",
    "login:fix-local": "node --import tsx scripts/fix-local-login.ts",
    "login:doctor": "node --import tsx scripts/login-doctor.ts",
    "production:check": "node scripts/production-check.mjs",
    "production:secrets": "node scripts/generate-production-secrets.mjs",
    "local:test": "node scripts/setup.mjs && node --import tsx scripts/fix-local-login.ts && node --import tsx scripts/login-doctor.ts && concurrently -k -n api,hr,admin \"npm:dev:embedded\" \"npm:dev:web\" \"npm:dev:admin\"",
    "phone:usb": "powershell -ExecutionPolicy Bypass -File ./scripts/phone-local-usb.ps1",
    "build:frontends": "npm run build --workspace=@peopleos/web && npm run build --workspace=@peopleos/super-admin",
    "phone:stable": "node scripts/setup.mjs && npm run configure:lan && node --import tsx scripts/fix-local-login.ts && node --import tsx scripts/login-doctor.ts && npm run build:frontends && concurrently -k -n api,hr,admin \"npm:dev:embedded\" \"npm run start --workspace=@peopleos/web\" \"npm run start --workspace=@peopleos/super-admin\"",
    "demo:dev": "npm run local:test",
    "build:backend": "npm run db:generate && tsc -p apps/api/tsconfig.build.json",
    "release:verify": "npm run typecheck && npm test && npm run build",
    "start:web": "npm run start --workspace=@peopleos/web",
    "start:admin": "npm run start --workspace=@peopleos/super-admin",
    "start:all": "node scripts/start-production.mjs",
    "host:check": "node scripts/production-check.mjs",
    "railway:start": "node scripts/railway-gateway.mjs",
    "railway:predeploy": "npm run db:migrate && npm run db:seed",
    "railway:boot": "npm run db:migrate && npm run db:seed && npm run railway:start",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.90.16",
    "bullmq": "^5.65.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.562.0",
    "multer": "^2.0.2",
    "next": "16.3.6",
    "nodemailer": "^7.0.12",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.57.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "pglite-prisma-adapter": "0.6.1",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@types/web-push": "^3.6.4"
  },
  "overrides": {
    "pglite-prisma-adapter": {
      "@prisma/driver-adapter-utils": "6.19.3"
    }
  }
}
