generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  code          String    @unique
  status        String    @default("TRIAL")
  plan          String    @default("STARTER")
  employeeLimit Int       @default(25)
  expiresAt     DateTime?
  currency      String    @default("INR")
  timezone      String    @default("Asia/Kolkata")
  profile       Json      @default("{}")
  logo          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  scope       String
  permissions String[]
  users       User[]

  @@map("roles")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String?   @map("tenant_id") @db.Uuid
  email              String
  loginId            String?   @map("login_id")
  name               String
  avatar             String?
  passwordHash       String
  roleId             String    @db.Uuid
  role               Role      @relation(fields: [roleId], references: [id])
  employeeId         String?   @db.Uuid
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  sessions           Session[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, email])
  @@unique([tenantId, loginId])
  @@index([email])
  @@index([loginId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  csrf      String
  expiresAt DateTime
  userAgent String
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("sessions")
}


model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String   @default("") @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("login_attempts")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("password_resets")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Outbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  kind      String
  payload   Json
  sentAt    DateTime?
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sentAt, createdAt])
  @@map("outbox")
}

model Branch {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String   @default("")
  location    String   @default("")
  addressLine String   @default("") @map("address_line")
  city        String   @default("")
  state       String   @default("")
  pincode     String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("designations")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("teams")
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("locations")
}

model CostCenter {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("cost_centers")
}

model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  employeeCode   String
  firstName      String
  lastName       String
  email          String
  phone          String    @default("")
  photo          String    @default("")
  departmentId   String?   @db.Uuid
  branchId       String?   @db.Uuid
  shiftId        String?   @map("shift_id") @db.Uuid
  managerId      String?   @db.Uuid
  designation    String    @default("")
  employmentType String    @default("FULL_TIME")
  joiningDate    DateTime  @db.Date
  status         String    @default("ACTIVE")
  monthlySalary  Int       @default(0)
  personal       Json      @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  @@map("employees")
}

model EmployeeFaceProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  templateCiphertext String   @map("template_ciphertext") @db.Text
  templateVersion    String   @default("face-api-1.7.15") @map("template_version")
  sampleCount        Int      @default(3) @map("sample_count")
  enrolledAt         DateTime @default(now()) @map("enrolled_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("employee_face_profiles")
}

model Shift {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  name                    String
  startMinute             Int
  endMinute               Int
  graceMinutes            Int      @default(10)
  earlyOutGraceMinutes    Int      @default(10) @map("early_out_grace_minutes")
  workingDays             String   @default("1,2,3,4,5") @map("working_days")
  workWeekMode            String   @default("CUSTOM_WEEKLY") @map("work_week_mode")
  alternateSaturdayMode   String   @default("SECOND_FOURTH_OFF") @map("alternate_saturday_mode")
  monthlyFlexibleOffDays  Int      @default(0) @map("monthly_flexible_off_days")
  breakMinutes            Int      @default(60)
  punchDrivenBreaks       Boolean  @default(false) @map("punch_driven_breaks")
  flexibleBreakAnytime    Boolean  @default(false) @map("flexible_break_anytime")
  breakStartMinute        Int?     @map("break_start_minute")
  breakEndMinute          Int?     @map("break_end_minute")
  fullDayMinutes          Int      @default(480)
  halfDayMinutes          Int      @default(240)
  overtimeAfterMinutes    Int      @default(480)
  timezone                String   @default("Asia/Kolkata")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("shifts")
}

model AttendanceDevice {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String
  vendor         String
  model          String    @default("")
  serialNumber   String
  branchId       String?   @db.Uuid
  host           String    @default("")
  port           Int       @default(5005)
  timezone       String    @default("Asia/Kolkata")
  connectionMode String    @default("CLOUD_PUSH") @map("connection_mode")
  apiSecretHash  String?   @map("api_secret_hash")
  apiSecretHint  String?   @map("api_secret_hint")
  status         String    @default("AWAITING_CONNECTION")
  lastSeenAt     DateTime? @map("last_seen_at")
  lastSync       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([tenantId, vendor])
  @@map("attendance_devices")
}

model DeviceEmployeeMap {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  deviceId     String    @map("device_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  deviceUserId String    @map("device_user_id")
  active       Boolean   @default(true)
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, deviceId, deviceUserId])
  @@unique([tenantId, deviceId, employeeId])
  @@index([tenantId, deviceId])
  @@index([tenantId, employeeId])
  @@map("device_employee_maps")
}

model DeviceSyncLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  level     String   @default("INFO")
  action    String
  message   String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, deviceId, createdAt])
  @@map("device_sync_logs")
}

model AttendancePunch {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  employeeId       String    @db.Uuid
  deviceId         String?   @db.Uuid
  sourceId         String
  punchTime        DateTime
  punchType        String
  verificationType String    @default("MANUAL")
  rawPayload       Json
  processedAt      DateTime?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, sourceId])
  @@index([tenantId])
  @@index([tenantId, employeeId, punchTime])
  @@map("attendance_punches")
}

model AttendanceDaily {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @db.Uuid
  shiftId         String?   @map("shift_id") @db.Uuid
  date            DateTime  @db.Date
  firstIn         DateTime?
  lastOut         DateTime?
  workMinutes     Int       @default(0)
  scheduledMinutes Int      @default(0) @map("scheduled_minutes")
  lateMinutes     Int       @default(0)
  earlyOutMinutes Int       @default(0) @map("early_out_minutes")
  overtimeMinutes Int       @default(0)
  payableUnits    Int       @default(0) @map("payable_units")
  leaveUnits      Int       @default(0) @map("leave_units")
  dayType         String    @default("WORKING") @map("day_type")
  status          String
  exceptionCode   String    @default("") @map("exception_code")
  correctionNote  String    @default("") @map("correction_note")
  lockedAt        DateTime? @map("locked_at")
  syncedAt        DateTime? @map("synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, date, status])
  @@map("attendance_daily")
}

model AttendancePeriodLock {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  month       String
  status      String    @default("LOCKED")
  lockedBy    String?   @map("locked_by")
  lockedAt    DateTime? @map("locked_at")
  unlockedBy  String?   @map("unlocked_by")
  unlockedAt  DateTime? @map("unlocked_at")
  summary     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, month])
  @@index([tenantId, status])
  @@map("attendance_period_locks")
}

model LeaveType {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  annualDays Decimal  @db.Decimal(5, 1)
  paid       Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("leave_types")
}

model LeaveRequest {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  employeeId  String   @db.Uuid
  leaveTypeId String   @db.Uuid
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  days        Decimal  @db.Decimal(5, 1)
  reason      String
  requestKey  String?  @map("request_key")
  status      String   @default("PENDING")
  reviewerId  String?
  reviewNote  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, requestKey])
  @@index([tenantId])
  @@index([tenantId, status, startDate])
  @@map("leave_requests")
}

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  shiftId     String?   @map("shift_id") @db.Uuid
  title       String
  date        DateTime  @db.Date
  endDate     DateTime? @db.Date
  kind        String    @default("HR_EVENT")
  description String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, shiftId, date])
  @@map("calendar_events")
}

model PayrollRun {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  month           String
  status          String        @default("DRAFT")
  totalGross      Int           @default(0)
  totalDeductions Int           @default(0)
  totalNet        Int           @default(0)
  approvedBy      String?
  lockedAt        DateTime?
  attendanceLockId String?       @map("attendance_lock_id") @db.Uuid
  items           PayrollItem[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, month])
  @@index([tenantId])
  @@map("payroll_runs")
}

model PayrollItem {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  runId        String     @db.Uuid
  run          PayrollRun @relation(fields: [tenantId, runId], references: [tenantId, id])
  employeeId   String     @db.Uuid
  employeeName String
  employeeCode String
  gross        Int
  deductions   Int
  net          Int
  scheduledDays Int        @default(0) @map("scheduled_days")
  payableUnits Int          @default(0) @map("payable_units")
  presentDays  Int          @default(0) @map("present_days")
  halfDays     Int          @default(0) @map("half_days")
  paidLeaveUnits Int        @default(0) @map("paid_leave_units")
  unpaidLeaveUnits Int      @default(0) @map("unpaid_leave_units")
  absentDays   Int          @default(0) @map("absent_days")
  lateMinutes  Int          @default(0) @map("late_minutes")
  overtimeMinutes Int       @default(0) @map("overtime_minutes")
  components   Json
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, runId, employeeId])
  @@index([tenantId])
  @@map("payroll_items")
}

model PayrollPayout {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  employeeName String   @map("employee_name")
  employeeCode String   @map("employee_code")
  amount       Int
  provider     String
  mode         String   @default("IMPS")
  status       String   @default("PENDING")
  providerRef  String?  @map("provider_ref")
  utr          String?
  reference    String
  error        String?
  details      Json     @default("{}")
  initiatedBy  String?  @map("initiated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, runId, employeeId])
  @@index([tenantId, runId])
  @@index([tenantId, status])
  @@map("payroll_payouts")
}

model PayrollAdjustment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  originalRunId String   @db.Uuid
  employeeId    String   @db.Uuid
  targetMonth   String
  amount        Int
  reason        String
  appliedRunId  String?  @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("payroll_adjustments")
}

model SalaryRule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  kind      String
  percent   Decimal  @db.Decimal(6, 3)
  cap       Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("salary_rules")
}

model Job {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  title          String
  departmentId   String?  @db.Uuid
  location       String
  openings       Int      @default(1)
  employmentType String   @default("FULL_TIME")
  description    String
  status         String   @default("OPEN")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("jobs")
}

model Candidate {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  email       String
  phone       String    @default("")
  jobId       String    @db.Uuid
  stage       String    @default("APPLIED")
  notes       String    @default("")
  interviewAt DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, jobId, stage])
  @@map("candidates")
}

model Goal {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @db.Uuid
  title      String
  target     Int      @default(100)
  progress   Int      @default(0)
  dueDate    DateTime @db.Date
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("goals")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String
  description String   @default("")
  trainer     String
  date        DateTime @db.Date
  capacity    Int      @default(20)
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("courses")
}

model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  assetTag     String
  category     String
  employeeId   String?   @db.Uuid
  status       String    @default("AVAILABLE")
  purchaseDate DateTime? @db.Date
  value        Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@map("assets")
}

model ExpenseClaim {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @db.Uuid
  title      String
  category   String
  amount     Int
  date       DateTime @db.Date
  status     String   @default("PENDING")
  notes      String   @default("")
  reviewedBy String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
