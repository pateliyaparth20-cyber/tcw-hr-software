{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "resolveJsonModule": true, "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["apps/api/**/*.ts", "apps/worker/**/*.ts", "apps/desktop-agent/**/*.ts", "packages/**/*.ts", "prisma/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "packages/ui"]
}
